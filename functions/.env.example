# Variáveis de ambiente das Cloud Functions (copia este arquivo para .env.local
# e preenche com valores locais; .env.local e gitignored).
#
# Em producao, defina os segredos via Secret Manager (firebase functions:secrets:set)
# e as variaveis nao-secretas via functions config/env.

# Token da conta Mercado Pago da plataforma (checkout legado / fallback).
MERCADOPAGO_ACCESS_TOKEN=

# URL publica HTTPS do webhook.
# Emulador: http://127.0.0.1:5001/<projeto>/southamerica-east1/mercadoPagoWebhook
MERCADOPAGO_WEBHOOK_URL=

# Segredo configurado no painel de notificacoes do Mercado Pago.
# Obrigatorio em producao (fail closed); ausente no emulador.
MERCADOPAGO_WEBHOOK_SECRET=

# Chave AES-256 para criptografar tokens OAuth dos vendedores (64 hex chars).
MERCADOPAGO_TOKEN_ENC_KEY=

# OAuth do fluxo "conectar conta Mercado Pago" (seller).
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=

# Segredo HMAC para claims de unicidade de CPF.
CPF_HMAC_SECRET=

# Segredo HMAC para claims de unicidade de CNPJ.
CNPJ_HMAC_SECRET=
