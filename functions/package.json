{
  "name": "meupet-agenda-functions",
  "version": "1.0.0",
  "description": "Cloud Functions backend for MeuPet Agenda (appointments, packages, payments)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && tsc -p tsconfig.test.json && mocha --timeout 30000 \"lib-test/test/**/*.test.js\"",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "private": true,
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "mercadopago": "^3.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "mocha": "^11.8.0",
    "typescript": "^7.0.2"
  }
}
